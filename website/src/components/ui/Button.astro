---
/**
 * Button with three looks: primary (white), ghost (text only) and secondary
 * (outlined). On hover a glow in the panel blue fades in behind it.
 * Adapted from Lapse (https://github.com/agnilem/lapse-astro).
 * Copyright (c) 2026 Alex Prokhorov. MIT License, see website/LICENSE-lapse.txt.
 */
interface Props { href: string; variant?: 'primary' | 'ghost' | 'secondary'; class?: string; [key: string]: unknown; }
const { href, variant = 'primary', class: cls, ...rest } = Astro.props;
const external = /^https?:/.test(href);
---
<a href={href} class:list={['btn', `btn--${variant}`, cls]} {...(external ? { target: '_blank', rel: 'noreferrer' } : {})} {...rest}>
  <span class="btn-glow-wrap" aria-hidden="true"><span class="btn-glow"></span></span>
  <span class="btn-surface" aria-hidden="true"></span>
  <span class="btn-label"><slot /></span>
</a>
<style>
  .btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    padding: 10px 24px; border-radius: 8px; flex: none; cursor: pointer;
  }
  .btn-glow-wrap {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center;
    padding: 2px 0; transition: padding 0.4s var(--ease-soft);
  }
  .btn-glow {
    width: 100%; flex: 1; border-radius: 9px; opacity: 0; background: rgb(91, 196, 241);
    box-shadow: 0 0 8px 0 rgba(91, 196, 241, 0.7), 0 2px 6px 0 rgba(91, 196, 241, 0.7), 0 3px 8px 0 rgba(59, 123, 220, 0.7), 0 6px 16px 0 rgba(140, 120, 255, 0.6), 0 8px 22px 0 rgba(91, 196, 241, 0.7);
    transition: opacity 0.4s var(--ease-soft);
    animation: btn-hue 3s ease-in-out infinite alternate;
  }
  .btn--ghost .btn-glow, .btn--secondary .btn-glow { display: none; }
  .btn-surface { position: absolute; inset: 1px; border-radius: 8px; transition: background 0.3s var(--ease-soft); }
  .btn--primary .btn-surface { background: var(--white); }
  .btn--secondary .btn-surface { box-shadow: inset 0 0 0 1px var(--grey-20); }
  .btn-label { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; user-select: none; text-align: center; font-size: 16px; line-height: 1.2em; }
  .btn--primary .btn-label { color: var(--black); font-weight: 500; }
  .btn--ghost .btn-label { color: var(--grey); transition: color 0.3s var(--ease-soft); }
  .btn--secondary .btn-label { color: var(--white); }
  @media (hover: hover) {
    .btn:hover .btn-glow-wrap { padding: 0; }
    .btn:hover .btn-glow { opacity: 1; }
    .btn--secondary:hover .btn-surface { background: var(--surface); }
    .btn--ghost:hover .btn-label { color: var(--white); }
  }
  @keyframes btn-hue { to { filter: hue-rotate(-40deg); } }
  @media (prefers-reduced-motion: reduce) { .btn-glow { animation: none; } }
</style>
