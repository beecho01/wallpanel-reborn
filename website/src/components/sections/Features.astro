---
/**
 * Pinned feature track: while the section is pinned the cards slide sideways
 * (src/scripts/fx/horizontal-track.js). Each card shows a small UI panel.
 * Layout adapted from Lapse's "What changes" section
 * (https://github.com/agnilem/lapse-astro), MIT, Copyright (c) 2026 Alex Prokhorov.
 */
import { links } from '../../lib/site';

const cards = [
  {
    title: 'Control it from anywhere',
    description: 'Send MQTT or HTTP commands to change the page, wake the screen, set brightness, play audio or speak a message out loud.',
    scene: 'scene--a',
  },
  {
    title: 'Report back to Home Assistant',
    description: 'Battery, light, pressure and temperature are published over MQTT, and Home Assistant discovers them automatically.',
    scene: 'scene--b',
  },
  {
    title: 'Wake up when you walk past',
    description: 'The front camera watches for motion or a face and turns the screen on. It can also read QR codes and stream MJPEG video.',
    scene: 'scene--c',
  },
  {
    title: 'Rest when nobody is looking',
    description: 'A built-in clock screensaver dims the display after a timeout, so an always-on panel doesn’t burn in or light up the room.',
    scene: 'scene--d',
  },
];
---
<section class="features" id="features" data-fx="horizontal-track">
  <div class="stage">
    <div class="title-row">
      <div class="title">
        <p class="t-eyebrow">What it does</p>
        <h2 class="t-h2 balance">More than a full-screen browser</h2>
        <p class="t-body-m">Everything a wall-mounted panel needs, built into one app. No extra services to run.</p>
      </div>
    </div>
    <div class="viewport">
      <div class="track">
        {cards.map((card, i) => (
          <article class="card">
            <h3 class="t-h4">{card.title}</h3>
            <div class:list={['scene', card.scene]}>
              {i === 0 && (
                <div class="panel">
                  <div class="head"><p class="mono-s grow">MQTT · wallpanel/hallway/command</p><p class="mono-s ok">SENT</p></div>
                  <pre class="code"><code><span class="k">{'{'}</span>
  <span class="s">"wake"</span>: <span class="v">true</span>,
  <span class="s">"brightness"</span>: <span class="v">200</span>,
  <span class="s">"speak"</span>: <span class="s">"Front door opened"</span>
<span class="k">{'}'}</span></code></pre>
                  <div class="route"><p class="mono-m grow">Home Assistant</p><p class="mono-m white">→ Hallway panel</p></div>
                </div>
              )}
              {i === 1 && (
                <div class="panel">
                  <div class="head"><p class="mono-s grow">SENSORS · AUTO-DISCOVERED</p><p class="mono-s ok">ONLINE</p></div>
                  <div class="rows">
                    {[
                      ['Battery', '87 %'],
                      ['Light level', '312 lx'],
                      ['Temperature', '21.4 °C'],
                      ['Pressure', '1013 hPa'],
                    ].map(([label, value], n) => (
                      <>
                        {n > 0 && <span class="divider" />}
                        <div class="row"><p class="row-label">{label}</p><p class="row-value">{value}</p></div>
                      </>
                    ))}
                  </div>
                </div>
              )}
              {i === 2 && (
                <div class="panel">
                  <div class="head"><p class="mono-s grow">CAMERA · MOTION</p><p class="mono-s live">● LIVE</p></div>
                  <div class="ends"><p class="mono-m">Screen off</p><p class="mono-m">Screen on</p></div>
                  <div class="timeline" aria-hidden="true"><span class="base"></span><span class="elapsed"></span><span class="halo"></span><span class="dot"></span></div>
                  <div class="message">
                    <p class="quote">Motion detected, waking the screen</p>
                    <div class="route"><p class="mono-m grow">Hallway panel</p><p class="mono-m white">07:42</p></div>
                  </div>
                </div>
              )}
              {i === 3 && (
                <div class="panel panel--clock">
                  <div class="head"><p class="mono-s grow">SCREENSAVER</p><p class="mono-s">DIMMED 15%</p></div>
                  <p class="clock">21:47</p>
                  <p class="mono-m">Wednesday, 21 October</p>
                  <div class="dim" aria-hidden="true"><span></span></div>
                </div>
              )}
            </div>
            <p class="t-body-m desc">{card.description}</p>
          </article>
        ))}
      </div>
    </div>
    <p class="t-body-s more">See the <a href={links.commands}>full command list</a> and <a href={links.sensors}>sensor reference</a>.</p>
  </div>
</section>
<style>
  .features { width: 100%; height: 2339px; display: flex; flex-direction: column; align-items: center; }
  .stage { position: sticky; top: 0; width: 100%; height: 960px; max-height: 100vh; min-height: 820px; padding: 100px 0 60px; background: var(--black); display: flex; flex-direction: column; align-items: center; gap: 56px; }
  .title-row { width: 100%; max-width: var(--canvas); padding: 0 20px; display: flex; flex-direction: column; align-items: center; }
  .title { width: 700px; display: flex; flex-direction: column; gap: 20px; text-align: center; }
  .viewport { width: 100%; overflow: clip; display: flex; }
  .track { display: flex; gap: 20px; align-items: stretch; flex: none; transform: translateX(var(--track-x, max(20px, calc((100vw - 1160px) / 2)))); will-change: transform; }
  .card { width: 570px; flex: none; display: flex; flex-direction: column; gap: 20px; padding: 40px; border-radius: var(--radius); background: var(--surface); overflow: clip; }
  .desc { color: var(--dark-grey); }
  .more { width: 100%; max-width: var(--canvas); padding: 0 20px; text-align: center; }
  .more a { color: var(--grey); text-decoration: underline; text-underline-offset: 3px; }

  .scene { position: relative; width: 100%; height: 300px; flex: none; display: flex; align-items: center; justify-content: center; padding: 0 40px; border-radius: var(--radius); overflow: clip; }
  .scene--a { background: radial-gradient(80% 90% at 10% 0%, rgba(91, 196, 241, 0.55), transparent 70%), radial-gradient(70% 80% at 100% 100%, rgba(59, 123, 220, 0.5), transparent 70%), rgb(26, 30, 36); }
  .scene--b { background: radial-gradient(80% 90% at 90% 0%, rgba(80, 220, 180, 0.45), transparent 70%), radial-gradient(70% 80% at 0% 100%, rgba(91, 196, 241, 0.4), transparent 70%), rgb(24, 32, 32); }
  .scene--c { background: radial-gradient(80% 90% at 0% 100%, rgba(140, 120, 255, 0.5), transparent 70%), radial-gradient(70% 80% at 100% 0%, rgba(91, 196, 241, 0.35), transparent 70%), rgb(28, 26, 38); }
  .scene--d { background: radial-gradient(90% 90% at 50% 0%, rgba(255, 190, 120, 0.32), transparent 70%), radial-gradient(70% 80% at 100% 100%, rgba(140, 120, 255, 0.35), transparent 70%), rgb(32, 28, 28); }

  .panel { position: relative; width: 100%; max-width: 380px; display: flex; flex-direction: column; gap: 16px; padding: 22px 24px; border-radius: var(--radius); background: var(--black); box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.55), inset 0 0 0 1px rgba(255, 255, 255, 0.05); overflow: clip; }
  .head, .route { display: flex; align-items: center; gap: 12px; }
  .grow { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mono-s { font-family: var(--font-mono); font-size: 11px; line-height: 1.2em; letter-spacing: 0.88px; color: var(--dark-grey); }
  .mono-m { font-family: var(--font-mono); font-size: 12px; line-height: 1.2em; color: var(--dark-grey); }
  .white { color: var(--white); }
  .ok { color: rgb(110, 220, 170); }
  .live { color: rgb(255, 120, 120); }

  .code { margin: 0; padding: 14px 16px; border-radius: 12px; background: var(--surface-2); font-size: 13px; line-height: 1.55em; color: var(--grey); overflow: hidden; white-space: pre; }
  .code .k { color: var(--dark-grey); }
  .code .s { color: rgb(160, 220, 245); }
  .code .v { color: rgb(255, 200, 140); }

  .rows { display: flex; flex-direction: column; }
  .row { display: flex; align-items: center; gap: 12px; padding: 9px 0; }
  .row-label { flex: 1 1 0; font-size: 15px; line-height: 1.2em; color: rgb(165, 164, 159); }
  .row-value { font-family: var(--font-mono); font-size: 14px; line-height: 1.2em; color: var(--white); }
  .divider { height: 1px; background: rgba(255, 255, 255, 0.07); }

  .ends { display: flex; justify-content: space-between; align-items: center; }
  .timeline { position: relative; height: 18px; }
  .timeline > span { position: absolute; border-radius: 999px; }
  .base { left: 0; right: 0; top: 8px; height: 2px; background: rgba(255, 255, 255, 0.12); }
  .elapsed { left: 0; top: 8px; width: 62%; height: 2px; background: var(--brand-gradient); }
  .halo { left: calc(62% - 12px); top: -3px; width: 24px; height: 24px; background: rgba(91, 196, 241, 0.2); }
  .dot { left: calc(62% - 7px); top: 2px; width: 14px; height: 14px; background: var(--white); }
  .message { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; border-radius: 12px; background: var(--surface-2); }
  .quote { font-size: 15px; font-weight: 500; line-height: 1.25em; color: var(--white); }

  .panel--clock { align-items: flex-start; gap: 10px; }
  .clock { font-size: 64px; line-height: 1em; font-weight: 300; letter-spacing: -0.04em; color: var(--white); margin-top: 6px; }
  .dim { width: 100%; height: 4px; margin-top: 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.1); overflow: hidden; }
  .dim span { display: block; width: 15%; height: 100%; background: var(--brand-gradient); }

  @media (max-width: 1199.98px) {
    .title { width: 100%; }
    .card { width: 480px; }
  }
  @media (max-width: 809.98px) {
    .features { height: auto; }
    .stage { position: relative; height: auto; min-height: 0; max-height: none; padding: 64px 0; gap: 32px; }
    .viewport { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .viewport::-webkit-scrollbar { display: none; }
    .track { transform: none; padding: 0 16px; gap: 12px; }
    .card { width: min(340px, calc(100vw - 48px)); padding: 20px; scroll-snap-align: center; }
    .scene { padding: 0 16px; height: 280px; }
    .panel { padding: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .track { will-change: auto; } }
</style>
