---
import { Image } from 'astro:assets';
import dashboard from '../../assets/screens/dashboard.png';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { links } from '../../lib/site';

const stats = [
  { value: 'Android 7.0+', label: 'Runs on old tablets and photo frames' },
  { value: 'Zero', label: 'Trackers, ads or accounts' },
  { value: 'Apache 2.0', label: 'Free and open source' },
];
---
<section class="hero">
  <div class="hero-top">
    <div class="hero-title">
      <p class="t-eyebrow">A continuation of WallPanel</p>
      <h1 class="t-h1 balance">Your dashboard, on the wall. <span class="muted">Always on, always in reach.</span></h1>
    </div>
    <div class="side">
      <p class="t-body-m">WallPanel Reborn turns any Android tablet into a dedicated control panel for Home Assistant or any web dashboard, with MQTT control, sensors, camera motion wake and a screensaver built in.</p>
      <div class="ctas">
        <Button href={links.download}><Icon name="download" size={16} />Download APK</Button>
        <Button href={links.gettingStarted} variant="secondary">Read the docs</Button>
      </div>
    </div>
  </div>
  <div class="hero-media">
    <div class="product" data-fx="appear">
      <div class="aurora" aria-hidden="true"></div>
      <div class="grid-lines" aria-hidden="true"></div>
      <div class="tablet">
        <Image class="screen" src={dashboard} alt="A Home Assistant dashboard shown full screen in WallPanel Reborn, with light, alarm and heater controls" widths={[800, 1400, 1920]} sizes="(max-width: 1199.98px) calc(100vw - 80px), 1000px" loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="stats">
      {stats.map((s) => (
        <div class="stat" data-fx="appear">
          <p class="t-num">{s.value}</p>
          <p class="t-eyebrow">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .hero { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 88px 20px 80px; display: flex; flex-direction: column; align-items: center; gap: 72px; }
  .hero-top { width: 100%; display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .hero-title { width: 640px; display: flex; flex-direction: column; gap: 24px; }
  .side { width: 340px; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero-media { width: 100%; display: flex; flex-direction: column; align-items: center; }

  .product {
    position: relative; width: 100%; padding: 64px 80px 0; border-radius: var(--radius); overflow: clip;
    background: rgb(20, 20, 20); display: flex; justify-content: center;
  }
  .aurora {
    position: absolute; inset: 0;
    background:
      radial-gradient(55% 70% at 18% 0%, rgba(91, 196, 241, 0.42), transparent 70%),
      radial-gradient(45% 60% at 88% 18%, rgba(59, 123, 220, 0.45), transparent 70%),
      radial-gradient(60% 55% at 50% 110%, rgba(140, 120, 255, 0.3), transparent 70%);
    filter: saturate(1.1);
  }
  .grid-lines {
    position: absolute; inset: 0; opacity: 0.35;
    background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(80% 80% at 50% 30%, #000 30%, transparent 80%);
  }
  .tablet {
    position: relative; width: 100%; max-width: 1000px; padding: 14px 14px 0; border-radius: 28px 28px 0 0;
    background: linear-gradient(180deg, rgb(38, 38, 38), rgb(14, 14, 14));
    box-shadow: 0 -1px 0 0 rgba(255, 255, 255, 0.12) inset, 0 40px 80px -20px rgba(0, 0, 0, 0.7);
  }
  .tablet :global(.screen) { width: 100%; height: auto; aspect-ratio: 1.6; object-fit: cover; object-position: top; border-radius: 16px 16px 0 0; }

  .stats { width: 100%; display: flex; align-items: stretch; gap: 20px; padding: 20px 0 0; }
  .stat { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; padding: 32px; border-radius: var(--radius); background: var(--surface); overflow: clip; }

  @media (max-width: 1199.98px) {
    .hero-top { flex-direction: column; align-items: flex-start; gap: 32px; }
    .hero-title, .side { width: 100%; }
    .side { max-width: 560px; }
    .product { padding: 48px 40px 0; }
  }
  @media (max-width: 809.98px) {
    .hero { padding: 48px 16px 64px; gap: 48px; }
    .hero-top { gap: 24px; }
    .product { padding: 28px 16px 0; }
    .tablet { padding: 8px 8px 0; border-radius: 18px 18px 0 0; }
    .tablet :global(.screen) { border-radius: 10px 10px 0 0; }
    .stats { flex-direction: column; gap: 12px; }
    .stat { padding: 24px; }
  }
</style>
